WEEK_PATTERNS = (
    re.compile(r"hafta[\s_\-:]*0*(\d{1,2})(?!\d)"),
    re.compile(r"(?<!\d)0*(\d{1,2})[\s.\-_]*hafta(?!l[ıi]k)"),
    re.compile(r"week[\s_\-]*0*(\d{1,2})(?!\d)"),
)


def week_marks(text: str):
    """[(konum, hafta_no)] listesi; 1..20 arası numaralar kabul edilir."""
    t = normalize_text(text)
    marks = []
    for rx in WEEK_PATTERNS:
        for m in rx.finditer(t):
            num = int(m.group(1))
            if 1 <= num <= 20:
                marks.append((m.start(), num))
    marks.sort()
    return marks


def weeks_in(text: str) -> set:
    return {num for _, num in week_marks(text)}


def scope_for_week(title, url, text, labels, n):
    """(ilgili_metin, neden). Boş metin = bu sayfa n. haftaya ait değil.
    Öncelik: başlık/URL/bağlantı etiketi > metin (tek hafta) > çok haftalı metnin ilgili bölümü."""
    head = weeks_in(f"{title} {url} {' '.join(labels)}")
    if head:
        return (text, "başlık/URL/bağlantı etiketi") if n in head else ("", "")
    marks = week_marks(text)
    nums = {num for _, num in marks}
    if n not in nums:
        return "", ""
    if nums == {n}:
        return text, "metin"
    base = text if len(normalize_text(text)) == len(text) else normalize_text(text)
    segs = []
    for i, (pos, num) in enumerate(marks):
        if num != n:
            continue
        end = next((p for p, m in marks[i + 1:] if m != n), len(base))
        segs.append(base[pos:end])
    uniq = []
    for s in segs:
        if not any(s in u for u in uniq):
            uniq.append(s)
    out = "\n\n".join(uniq)
    return (out, "çok haftalı metnin ilgili bölümü") if len(out) >= 120 else ("", "")


def week_state(url, labels, n):
    """'match' | 'other' | 'neutral': kaynağın URL/etiketleri hangi haftayı söylüyor?"""
    w = weeks_in(f"{url} {' '.join(labels)}")
    if not w:
        return "neutral"
    return "match" if n in w else "other"


