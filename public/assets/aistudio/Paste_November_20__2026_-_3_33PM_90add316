STRING_RE = re.compile(
    r"""'((?:\\.|[^'\\\n])*)'|"((?:\\.|[^"\\\n])*)"|`((?:\\.|[^`\\])*)`""", re.S
)


def unescape_js(s: str) -> str:
    s = re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m.group(1), 16)), s)
    return (
        s.replace("\\n", "\n").replace("\\r", "").replace("\\t", "\t")
        .replace('\\"', '"').replace("\\'", "'").replace("\\\\", "\\")
    )


def extract_strings(source: str) -> list:
    seen, out, total = set(), [], 0
    for m in STRING_RE.finditer(source):
        raw = next((g for g in m.groups() if g is not None), "")
        s = unescape_js(raw).strip()
        if len(s) < 20 or s.startswith(("http", "data:", "#", "/")):
            continue
        if " " not in s and "\n" not in s:
            continue
        if not re.search(r"[A-Za-zÇĞİÖŞÜçğıöşü]{3}", s) or s in seen:
            continue
        seen.add(s)
        out.append(s)
        total += len(s)
        if total > MAX_RESOURCE_STRINGS_CHARS:
            break
    return out


def derive_from_resources(pages: dict):
    """JS/JSON kaynaklarından sanal görev ve kod sayfaları üretir."""
    for key, res in list(pages.items()):
        if res["kind"] != "resource":
            continue
        base_url = res["url"]
        short = base_url.rsplit("/", 1)[-1]
        strings = res["strings"]
        task_idx = set()
        for i, s in enumerate(strings):
            ns = normalize_text(s)
            if STRONG_WORDS.search(ns) or WEAK_WORDS.search(ns):
                task_idx.update({i - 1, i, i + 1})
        task_lines = [strings[i] for i in sorted(task_idx) if 0 <= i < len(strings)]
        code_lines = [s for s in strings if CODE_LINE.search(s) and len(s) >= 30]

        if task_lines:
            tu = f"{base_url}#gorev-metinleri"
            pages[tu] = {
                "url": tu, "title": f"JS verisindeki görev metinleri ({short})",
                "text": "\n\n".join(task_lines)[:MAX_TASK_CHARS * 3], "links": [],
                "kind": "page", "origin": base_url,
            }
        if code_lines:
            cu = f"{base_url}#kod-parcalari"
            pages[cu] = {
                "url": cu, "title": f"JS verisindeki kod parçaları ({short})",
                "text": "\n\n".join(code_lines)[:MAX_TASK_CHARS * 3], "links": [],
                "kind": "source", "origin": base_url,
            }


