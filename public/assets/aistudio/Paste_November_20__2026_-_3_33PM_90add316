def find_identity_pages(pages, pattern=None):
    """[(url, neden)] — güçlüden zayıfa sıralı. Ajan bu sayfalara yalnızca BAKAR."""
    real = [
        (url, p) for url, p in pages.items()
        if p["kind"] == "page" and "#etkilesim-" not in url
        and "#gorev-metinleri" not in url and "#kod-parcalari" not in url
    ]
    if pattern:
        rx = re.compile(pattern, re.IGNORECASE)
        return [(u, "kullanıcı deseni") for u, p in real
                if rx.search(normalize_text(f"{p['title']} {u} {p['text']}"))]
    tier1 = [(u, "alan etiketi") for u, p in real if p.get("has_identity")]
    used = {u for u, _ in tier1}
    tier2 = [(u, "metin + giriş alanı") for u, p in real
             if u not in used and p.get("input_count", 0) > 0
             and IDENTITY_PATTERN.search(normalize_text(p["text"]))]
    used |= {u for u, _ in tier2}
    tier3 = [(u, "olası (giriş alanı var)") for u, p in real
             if u not in used and p.get("input_count", 0) >= 2]
    return tier1 + tier2 + tier3


def find_form_links(pages):
    """Harici form/teslim bağlantıları (Google Forms vb.). Taranmaz, sadece listelenir."""
    seen, out = set(), []
    for p in pages.values():
        for l in p.get("links", []):
            href = l.get("href") or ""
            if not href.startswith(("http://", "https://")) or href in seen:
                continue
            label = normalize_text(l.get("label", "") or "")
            if FORM_HREF.search(href) or FORM_LABEL.search(label):
                seen.add(href)
                out.append((href, (l.get("label", "") or "").strip()[:50]))
    return out


def choose_identity_link(ident, forms):
    strong = [u for u, why in ident if why != "olası (giriş alanı var)"]
    weak = [u for u, why in ident if why == "olası (giriş alanı var)"]
    if strong:
        return strong[0]
    if forms:
        return forms[0][0]
    if weak:
        return weak[0]
    return CFG.start_url


