# Kod bloğu çıkarma ve doğrulama
# ----------------------------------------------------------------------------
FENCE_RE = re.compile(r"```([\w+#.\-]*)[ \t]*\n(.*?)(?:```|\Z)", re.S)
PY_LANGS = {"python", "py", "python3", "py3"}
PY_HINT = re.compile(r"^\s*(def|class|import|from)\s+\w+", re.M)
NON_PY_HINT = re.compile(r"using\s+System|namespace\s+\w+|Console\.|public\s+static\s+void|#include|\bvar\s+\w+\s*=.*;")

RISKY_IMPORTS = {"subprocess", "socket", "requests", "urllib", "shutil", "ctypes", "http",
                 "ftplib", "smtplib", "webbrowser"}
RISKY_CALLS = {"eval", "exec", "__import__", "compile"}
RISKY_ATTRS = {("os", "system"), ("os", "remove"), ("os", "rmdir"), ("os", "unlink"),
               ("os", "popen"), ("shutil", "rmtree")}


def extract_code_blocks(answer: str):
    """Python olabilecek blokları döndürür: [{'code', 'closed'}].
    Etiketsiz bloklar python gibi görünüyorsa alınır; csharp/json/bash vb. etiketliler atlanır."""
    blocks = []
    for m in FENCE_RE.finditer(answer):
        lang = m.group(1).lower()
        code = m.group(2)
        closed = m.group(0).endswith("```")
        if lang in PY_LANGS:
            pass
        elif lang == "":
            if NON_PY_HINT.search(code) or not (PY_HINT.search(code) or check_python(code) is None):
                continue
        else:
            continue
        if code.strip():
            blocks.append({"code": code, "closed": closed})
    return blocks


def check_python(code: str):
    """Sözdizimi hatası varsa açıklama, yoksa None. (Kod ÇALIŞTIRILMAZ.)"""
    try:
        ast.parse(code)
        return None
    except SyntaxError as exc:
        return f"{exc.msg} (satır {exc.lineno})"
    except ValueError as exc:
        return str(exc)


def risky_findings(code: str):
    out = set()
    try:
        tree = ast.parse(code)
    except (SyntaxError, ValueError):
        return []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for a in node.names:
                if a.name.split(".")[0] in RISKY_IMPORTS:
                    out.add(f"import {a.name}")
        elif isinstance(node, ast.ImportFrom):
            if (node.module or "").split(".")[0] in RISKY_IMPORTS:
                out.add(f"from {node.module} import ...")
        elif isinstance(node, ast.Call):
            f = node.func
            if isinstance(f, ast.Name) and f.id in RISKY_CALLS:
                out.add(f"{f.id}()")
            elif isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name) \
                    and (f.value.id, f.attr) in RISKY_ATTRS:
                out.add(f"{f.value.id}.{f.attr}()")
    return sorted(out)


