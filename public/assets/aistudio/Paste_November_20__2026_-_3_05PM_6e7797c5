# ----------------------------------------------------------------------------
def extract_zip_text(data: bytes, label: str, budget: Budget) -> str:
    limit = min(MAX_ZIP_TOTAL_CHARS, budget.zip_chars)
    if limit <= 0:
        return ""
    candidates = []
    try:
        with zipfile.ZipFile(BytesIO(data)) as archive:
            for item in archive.infolist():
                lower = "/" + item.filename.lower()
                if item.is_dir() or item.file_size > MAX_ZIP_FILE_BYTES:
                    continue
                if any(skip in lower for skip in ZIP_SKIP_DIRS):
                    continue
                if not lower.endswith(ZIP_TEXT_EXTENSIONS):
                    continue
                priority = 0 if lower.endswith((".cs", ".java", ".py", ".cpp", ".c", ".h")) else 1
                candidates.append((priority, item.filename, item))
            candidates.sort(key=lambda c: (c[0], c[1]))
            pieces, total = [], 0
            for _, name, item in candidates:
                remaining = limit - total
                if remaining <= 0:
                    break
                try:
                    raw = archive.read(item)
                except Exception:
                    continue
                content = decode_text(raw)[: min(MAX_ZIP_FILE_CHARS, remaining)]
                if content.strip():
                    pieces.append(f"DOSYA: {name}\n{content}")
                    total += len(content)
            budget.zip_chars -= total
            return "\n\n".join(pieces)
    except zipfile.BadZipFile:
        return ""


async def download(http_client, url, budget: Budget):
    if budget.bytes <= 0:
        raise ValueError("Ortak indirme bütçesi doldu")
    cap = min(MAX_DOWNLOAD_BYTES, budget.bytes)
    async with http_client.stream("GET", url) as response:
        response.raise_for_status()
        final_url = str(response.url)
        if not is_allowed(final_url):
            raise ValueError(f"İzin verilmeyen yönlendirme: {final_url}")
        chunks, size = [], 0
        async for chunk in response.aiter_bytes():
            size += len(chunk)
            if size > cap:
                raise ValueError("Dosya boyut/bütçe sınırını aşıyor")
            chunks.append(chunk)
        budget.bytes -= size
        return b"".join(chunks), final_url, response.headers.get("content-type", "").lower()


async def fetch_source(http_client, url, budget: Budget) -> str:
    if not is_allowed(url) or budget.fetches <= 0:
        return ""
    zip_candidates = github_repo_zip_candidates(url)
    targets = zip_candidates or [github_blob_to_raw(url)]
    if host_of(url) == "github.com" and not zip_candidates and targets[0] == url:
        return ""
    budget.fetches -= 1
    for target in targets:
        try:
            data, final_url, ctype = await download(http_client, target, budget)
            if path_of(final_url).endswith(".zip") or "zip" in ctype or zip_candidates:
                return extract_zip_text(data, final_url, budget)
            if not path_of(final_url).endswith(RAW_EXTENSIONS):
                if not any(t in ctype for t in ("text/", "json", "xml")):
                    return ""
            text = decode_text(data)
            if "html" in ctype:
                parser = VisibleTextParser()
                parser.feed(text)
                text = "\n".join(parser.parts)
            return text[: MAX_SOURCE_PER_ITEM * 3]
        except Exception as exc:
            log(f"[uyarı] Kaynak okunamadı: {target} ({exc})")
    return ""


