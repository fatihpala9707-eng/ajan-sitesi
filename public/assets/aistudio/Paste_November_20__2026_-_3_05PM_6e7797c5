# ----------------------------------------------------------------------------
# Yardımcılar
# ----------------------------------------------------------------------------
def normalize_text(value: str) -> str:
    return value.replace("İ", "i").replace("I", "ı").lower()


def fingerprint(text: str) -> str:
    squashed = re.sub(r"\s+", " ", normalize_text(text)).strip()[:1500]
    return hashlib.md5(squashed.encode("utf-8")).hexdigest()


def normalized_url(url: str) -> str:
    clean = urldefrag(url)[0]
    parts = urlsplit(clean)
    path = parts.path if parts.path in ("", "/") else parts.path.rstrip("/")
    return urlunsplit((parts.scheme, parts.netloc.lower(), path, parts.query, ""))


def host_of(url: str) -> str:
    return (urlsplit(url).hostname or "").lower()


def path_of(url: str) -> str:
    return urlsplit(url).path.lower()


def extension_of(url: str) -> str:
    last = path_of(url).rsplit("/", 1)[-1]
    return "." + last.rsplit(".", 1)[1] if "." in last else ""


def is_same_site(url: str) -> bool:
    return host_of(url) == host_of(START_URL)


def is_allowed_external(url: str) -> bool:
    return host_of(url) in ALLOWED_EXTERNAL_HOSTS


def is_allowed(url: str) -> bool:
    return is_same_site(url) or is_allowed_external(url)


def is_raw_file(url: str) -> bool:
    return path_of(url).endswith(RAW_EXTENSIONS)


def is_crawlable_page(url: str) -> bool:
    return is_same_site(url) and extension_of(url) in PAGE_EXTENSIONS


def is_source_link(url: str) -> bool:
    if not is_allowed(url):
        return False
    return is_raw_file(url) or host_of(url) in ALLOWED_EXTERNAL_HOSTS


def github_parts(url: str):
    parts = urlsplit(url)
    if (parts.hostname or "").lower() != "github.com":
        return None
    segs = [s for s in parts.path.split("/") if s]
    if len(segs) < 2:
        return None
    return segs[0], segs[1].removesuffix(".git"), segs[2:]


def github_blob_to_raw(url: str) -> str:
    gp = github_parts(url)
    if gp and len(gp[2]) >= 3 and gp[2][0] == "blob":
        owner, repo, rest = gp
        return f"https://raw.githubusercontent.com/{owner}/{repo}/{'/'.join(rest[1:])}"
    return url


def github_repo_zip_candidates(url: str):
    gp = github_parts(url)
    if not gp:
        return []
    owner, repo, rest = gp
    if rest and rest[0] == "tree" and len(rest) >= 2:
        branches = [rest[1]]
    elif not rest:
        branches = ["main", "master"]
    else:
        return []
    return [f"https://codeload.github.com/{owner}/{repo}/zip/refs/heads/{b}" for b in branches]


def decode_text(data: bytes) -> str:
    for enc in ("utf-8-sig", "utf-8", "cp1254", "latin-1"):
        try:
            return data.decode(enc)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", errors="replace")


def slugify(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9]+", "_", value).strip("_")[-80:] or "sayfa"


def tokens(text: str) -> set:
    return set(re.findall(r"[a-zçğıöşü_]{4,}", normalize_text(text)))


class VisibleTextParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.parts, self.skip = [], 0

    def handle_starttag(self, tag, attrs):
        if tag in {"script", "style", "noscript", "svg"}:
            self.skip += 1

    def handle_endtag(self, tag):
        if tag in {"script", "style", "noscript", "svg"} and self.skip:
            self.skip -= 1

    def handle_data(self, data):
        if not self.skip and data.strip():
            self.parts.append(data.strip())


class Budget:
    def __init__(self):
        self.fetches = MAX_SOURCE_FETCHES
        self.bytes = MAX_TOTAL_DOWNLOAD_BYTES
        self.zip_chars = MAX_TOTAL_ZIP_CHARS


# ----------------------------------------------------------------------------
# JS/JSON içindeki metinleri çıkarma (görevler ve kodlar burada olabilir)
# ----------------------------------------------------------------------------
STRING_RE = re.compile(
    r"""'((?:\\.|[^'\\\n])*)'|"((?:\\.|[^"\\\n])*)"|`((?:\\.|[^`\\])*)`""", re.S
)


def unescape_js(s: str) -> str:
    s = re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m.group(1), 16)), s)
    return (
        s.replace("\\n", "\n").replace("\\r", "").replace("\\t", "\t")
        .replace('\\"', '"').replace("\\'", "'").replace("\\\\", "\\")
    )


def extract_strings(source: str) -> list:
    """Kaynak koddaki okunabilir uzun metinleri (UI metni, görev, kod şablonu) listeler."""
    seen, out, total = set(), [], 0
    for m in STRING_RE.finditer(source):
        raw = next((g for g in m.groups() if g is not None), "")
        s = unescape_js(raw).strip()
        if len(s) < 20 or s.startswith(("http", "data:", "#", "/")):
            continue
        if " " not in s and "\n" not in s:
            continue
        if not re.search(r"[A-Za-zÇĞİÖŞÜçğıöşü]{3}", s) or s in seen:
            continue
        seen.add(s)
        out.append(s)
        total += len(s)
        if total > MAX_RESOURCE_STRINGS_CHARS:
            break
    return out


def derive_from_resources(pages: dict):
    """JS/JSON kaynaklarından sanal görev ve kod sayfaları üretir."""
    for url, res in list(pages.items()):
        if res["kind"] != "resource":
            continue
        strings = res["strings"]
        task_idx = set()
        for i, s in enumerate(strings):
            if TASK_WORDS.search(normalize_text(s)):
                task_idx.update({i - 1, i, i + 1})
        task_lines = [strings[i] for i in sorted(task_idx) if 0 <= i < len(strings)]
        code_lines = [s for s in strings if CODE_LINE.search(s) and len(s) >= 30]

        if task_lines:
            tu = f"{url}#gorev-metinleri"
            pages[tu] = {
                "url": tu, "title": f"JS verisindeki görev metinleri ({url.rsplit('/', 1)[-1]})",
                "text": "\n\n".join(task_lines)[:MAX_SITE_CHARS], "links": [],
                "kind": "page", "origin": url,
            }
        if code_lines:
            cu = f"{url}#kod-parcalari"
            pages[cu] = {
                "url": cu, "title": f"JS verisindeki kod parçaları ({url.rsplit('/', 1)[-1]})",
                "text": "\n\n".join(code_lines)[:MAX_SITE_CHARS], "links": [],
                "kind": "source", "origin": url,
            }


