# Ana akış
# ----------------------------------------------------------------------------
async def main(args):
    global START_URL, DEBUG
    START_URL = args.start_url
    DEBUG = args.debug

    api_key = os.getenv("OPENAI_API_KEY")
    if not args.dry_run and not api_key:
        raise RuntimeError("OPENAI_API_KEY tanımlı değil. (Yalnızca denemek için --dry-run kullanın.)")

    budget = Budget()
    async with httpx.AsyncClient(
        timeout=httpx.Timeout(25.0, connect=10.0),
        limits=httpx.Limits(max_connections=MAX_CONCURRENT * 2),
        follow_redirects=True,
        headers={"User-Agent": "DersKaynakAjan/1.0"},
    ) as http_client:
        async with async_playwright() as p:
            browser = await p.chromium.launch(
                headless=not args.visible, slow_mo=200 if args.visible else 0
            )
            context = await browser.new_context()
            try:
                pages, source_urls = await crawl(context, http_client, budget, explore=not args.no_explore)
            finally:
                await context.close()
                await browser.close()

    dump_pages(pages)
    html_pages = [p for p in pages.values() if p["kind"] == "page"]
    resources = [p for p in pages.values() if p["kind"] == "resource"]
    source_pages = [p for p in pages.values() if p["kind"] == "source"]
    log(f"Tarama bitti: {len(html_pages)} sayfa/etkileşim, {len(resources)} JS/JSON dosyası, "
        f"{len(source_urls)} kaynak bağlantısı, {len(source_pages)} kaynak okundu.")
    if not html_pages:
        raise RuntimeError("Hiç içerik alınamadı. --visible ile deneyin, dump/ ve çıktıyı inceleyin.")

    tasks = find_task_pages(pages, args.task_pattern)
    if not tasks:
        log("[uyarı] Görev kalıbı bulunamadı; YEDEK yola geçiliyor (tüm site içeriği tek görev).")
        tasks = site_wide_fallback(pages)
    if not source_pages:
        log("[uyarı] Ayrı kaynak kod bulunamadı; kodlar görev metninde/JS verisinde olabilir.")

    prepared = []
    for item in tasks:
        source_text, used = select_sources(pages, item["url"], item["page"])
        prepared.append((item, source_text, used))

    if args.dry_run:
        for item, _, used in prepared:
            print(f"\nGÖREV: {item['url']}\n  başlık: {item['page']['title']}"
                  f"\n  puan: {item['score']} | neden: {'; '.join(item['reasons'])}"
                  f"\n  metin: {len(item['page']['text'])} karakter")
            for url, n in used:
                print(f"  kaynak: {url} ({n} karakter)")
            if not used:
                print("  kaynak: (yok)")
        print("\n[bilgi] Dry-run bitti; OpenAI çağrısı yapılmadı. dump/_ozet.txt dosyasına bakın.")
        return

    client = AsyncOpenAI(api_key=api_key, max_retries=5)
    semaphore = asyncio.Semaphore(MAX_CONCURRENT)
    log(f"{len(prepared)} görev OpenAI'a gönderiliyor...")
    answers = await asyncio.gather(*(solve_one(client, item, src, semaphore) for item, src, _ in prepared))

    os.makedirs("cozumler", exist_ok=True)
    for (item, src, _), answer in zip(prepared, answers):
        print(f"\n{'=' * 78}\nGÖREV: {item['page']['title']}\n{item['url']}\n{'=' * 78}")
        if isinstance(answer, Exception):
            print(f"[hata] Bu görev çözülemedi: {answer}")
            continue
        if not src:
            print("[bilgi] Ayrı kaynak bulunamadı; çözüm görev metnindeki bilgilerle üretildi.")
        print(answer)
        with open(f"cozumler/{slugify(item['url'])}.md", "w", encoding="utf-8") as f:
            f.write(f"# {item['page']['title']}\n\n{item['url']}\n\n{answer}\n")


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description="Ders sitesi görev/kaynak ajanı")
    ap.add_argument("--start-url", default=START_URL)
    ap.add_argument("--dry-run", action="store_true", help="OpenAI çağırmadan sonucu göster")
