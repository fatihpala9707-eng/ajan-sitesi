def save_solution(week, i, item, answer, results, used):
    base = f"cozumler/hafta{week}_gorev{i}_{slugify(item['url'])}"
    with open(base + ".md", "w", encoding="utf-8") as f:
        f.write(f"# {item['page']['title']}\n\n{item['url']}\n\n")
        f.write("> Not: Kod çalıştırılmadı. Yalnızca sözdizimi denetlendi (ast.parse); "
                "doğru çalıştığı doğrulanmadı.\n\n")
        if used:
            f.write("Kullanılan kaynaklar:\n" + "\n".join(f"- {u} ({r})" for u, _, r in used) + "\n\n")
        f.write(answer + "\n")
    for k, (code, err) in enumerate(results, 1):
        suffix = "" if len(results) == 1 else f"_{k}"
        if err:
            path = f"{base}{suffix}.HATALI.txt"
            body = f"# SÖZDİZİMİ HATASI: {err}\n{code}"
        else:
            path = f"{base}{suffix}.py"
            body = code
        with open(path, "w", encoding="utf-8") as f:
            f.write(body)
        status = f"SÖZDİZİMİ HATALI ({err}) -> .py olarak kaydedilmedi" if err else "sözdizimi geçerli (çalışması doğrulanmadı)"
        print(f"[doğrulama] {os.path.basename(path)}: {status}")
        for r in risky_findings(code):
            print(f"[DİKKAT] {os.path.basename(path)} riskli işlem içeriyor: {r} -> çalıştırmadan önce incele")


def print_selection(item, used, skipped):
    page = item["page"]
    print(f"\nGÖREV: {item['url']}")
    print(f"  başlık: {page['title']}")
    print(f"  puan: {item['score']} | neden: {'; '.join(item['reasons'])}")
    print(f"  seçilen metin: {len(page['text'])}/{item.get('original_chars', len(page['text']))} karakter")
    print(f"  önizleme: {re.sub(r'\\s+', ' ', page['text'])[:90]}")
    for label, n, reason in used:
        print(f"  + kaynak: {label} ({n} karakter) -> {reason}")
    if not used:
        print("  + kaynak: (yok)")
    for label, reason in skipped[:8]:
        print(f"  - elendi: {label} -> {reason}")
    if len(skipped) > 8:
        print(f"  - ... ve {len(skipped) - 8} kaynak/dosya daha elendi")


def write_report(week, prepared, uncertain, ident, forms, link, note):
    os.makedirs("cozumler", exist_ok=True)
    path = f"cozumler/hafta{week}_rapor.md"
    lines = [f"# Hafta {week} raporu", "", f"Model durumu: {note}", ""]
    lines.append("## Seçilen görevler")
    for item, _, used, skipped in prepared:
        lines.append(f"- {item['url']} ({'; '.join(item['reasons'])})")
        lines.extend(f"    - kaynak: {u} -> {r}" for u, _, r in used)
        lines.extend(f"    - elendi: {u} -> {r}" for u, r in skipped[:10])
    lines += ["", "## Hafta bilgisi belirsiz (ATANMADI)"]
    lines.extend(f"- {u}: {why}" for u, why in uncertain) if uncertain else lines.append("- (yok)")
    lines += ["", "## Ad / okul no bölümü (sen dolduracaksın)"]
    lines.extend(f"- sayfa [{why}]: {u}" for u, why in ident[:5])
    lines.extend(f"- form bağlantısı: {h}" for h, _ in forms[:5])
    lines.append(f"- önerilen link: {link}")
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    return path


def dump_pages(pages, folder="dump"):
    os.makedirs(folder, exist_ok=True)
    summary = []
    for url, page in pages.items():
        links = "\n".join(f"  - {l.get('label', '')!r} -> {l.get('href')}" for l in page["links"])
        name = f"{folder}/{page['kind']}_{slugify(url)}.txt"
        with open(name, "w", encoding="utf-8") as f:
            f.write(f"URL: {url}\nBAŞLIK: {page['title']}\nTÜR: {page['kind']}\n\n")
            f.write(page["text"] + "\n\nBAĞLANTILAR:\n" + links + "\n")
        summary.append(f"{page['kind']:9} {len(page['text']):7} karakter  {url}")
    with open(f"{folder}/_ozet.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(summary))
    log(f"{len(pages)} kayıt '{folder}/' klasörüne yazıldı (özet: {folder}/_ozet.txt)")


