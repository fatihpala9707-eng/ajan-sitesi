async def guard_request(route):
    """Salt-okunur + yan etkisiz gezinme: şüpheli istekler tarayıcıya hiç ulaşmaz."""
    req = route.request
    url = req.url
    if url.startswith(("data:", "blob:", "about:")):
        await route.continue_()
        return
    parts = urlsplit(url)
    reason = None
    if req.method not in SAFE_METHODS:
        reason = f"{req.method} yazma isteği"
    elif req.resource_type in BLOCKED_TYPES:
        reason = "kalıcı bağlantı/beacon"
    elif TRACKER_URL.search(url):
        reason = "izleyici"
    elif req.resource_type in ("document", "xhr", "fetch", "other") and \
            UNSAFE_GET.search(f"{parts.path}?{parts.query}"):
        reason = "yan etkili görünen GET adresi"
    elif req.is_navigation_request() and not is_allowed(url):
        reason = "izinsiz adrese yönlendirme"
    if reason:
        log(f"[engellendi] {reason}: {req.method} {url[:120]}")
        await route.abort()
    else:
        await route.continue_()


async def new_safe_context(browser):
    context = await browser.new_context(accept_downloads=False, service_workers="block")
    await context.route("**/*", guard_request)

    async def _dismiss(dialog):
        try:
            await dialog.dismiss()          # alert/confirm/prompt asla onaylanmaz
        except Exception:
            pass

    context.on("page", lambda pg: pg.on("dialog", lambda d: asyncio.ensure_future(_dismiss(d))))
    return context


