def extract_zip_files(data, budget):
    """[(dosya_adı, içerik)] döndürür. Seçili hafta biliniyorsa o haftanın dosyaları öne alınır."""
    limit = min(MAX_ZIP_TOTAL_CHARS, budget.zip_chars)
    if limit <= 0:
        return []
    candidates = []
    try:
        with zipfile.ZipFile(BytesIO(data)) as archive:
            for item in archive.infolist():
                lower = "/" + item.filename.lower()
                if item.is_dir() or item.file_size > MAX_ZIP_FILE_BYTES:
                    continue
                if any(skip in lower for skip in ZIP_SKIP_DIRS):
                    continue
                if not lower.endswith(ZIP_TEXT_EXTENSIONS):
                    continue
                file_weeks = weeks_in(item.filename)
                if CFG.week and file_weeks and CFG.week not in file_weeks:
                    continue                      # başka haftanın dosyasını hiç okuma
                week_first = 0 if (CFG.week and CFG.week in file_weeks) else 1
                code_first = 0 if lower.endswith((".cs", ".java", ".py", ".cpp", ".c", ".h")) else 1
                candidates.append((week_first, code_first, item.filename, item))
            candidates.sort(key=lambda c: (c[0], c[1], c[2]))
            files, total = [], 0
            for _, _, name, item in candidates:
                remaining = limit - total
                if remaining <= 0:
                    break
                try:
                    raw = archive.read(item)
                except Exception:
                    continue
                content = decode_text(raw)[: min(MAX_ZIP_FILE_CHARS, remaining)]
                if content.strip():
                    files.append((name, content))
                    total += len(content)
            budget.zip_chars -= total
            return files
    except zipfile.BadZipFile:
        return []


async def download(http_client, url, budget):
    """Yönlendirmeleri elle izler; her adım istekten ÖNCE izinli listeyle kontrol edilir."""
    if budget.bytes <= 0:
        raise ValueError("Ortak indirme bütçesi doldu")
    cap = min(MAX_DOWNLOAD_BYTES, budget.bytes)
    current = url
    for _ in range(MAX_REDIRECTS + 1):
        if not is_allowed(current):
            raise ValueError(f"İzin verilmeyen adres: {current}")
        async with http_client.stream("GET", current) as response:
            if response.is_redirect:
                location = response.headers.get("location")
                if not location:
                    raise ValueError("Yönlendirme hedefi yok")
                current = str(httpx.URL(current).join(location))
                continue
            response.raise_for_status()
            chunks, size = [], 0
            async for chunk in response.aiter_bytes():
                size += len(chunk)
                if size > cap:
                    raise ValueError("Dosya boyut/bütçe sınırını aşıyor")
                chunks.append(chunk)
            budget.bytes -= size
            return b"".join(chunks), current, response.headers.get("content-type", "").lower()
    raise ValueError("Çok fazla yönlendirme")


async def fetch_source(http_client, url, budget):
    """(metin, dosyalar) döndürür. dosyalar yalnızca zip/repo için dolu."""
    if not is_allowed(url) or budget.fetches <= 0:
        return "", []
    zip_candidates = github_repo_zip_candidates(url)
    targets = zip_candidates or [github_blob_to_raw(url)]
    if host_of(url) == "github.com" and not zip_candidates and targets[0] == url:
        return "", []
    budget.fetches -= 1
    for target in targets:
        try:
            data, final_url, ctype = await download(http_client, target, budget)
            if path_of(final_url).endswith(".zip") or "zip" in ctype or zip_candidates:
                files = extract_zip_files(data, budget)
                text = "\n\n".join(f"DOSYA: {n}\n{c}" for n, c in files)
                return text, files
            if not path_of(final_url).endswith(RAW_EXTENSIONS):
                if not any(t in ctype for t in ("text/", "json", "xml")):
                    return "", []
            text = decode_text(data)
            if "html" in ctype:
                parser = VisibleTextParser()
                parser.feed(text)
                text = "\n".join(parser.parts)
            return text[: MAX_SOURCE_PER_ITEM * 3], []
        except Exception as exc:
            log(f"[uyarı] Kaynak okunamadı: {target} ({exc})")
    return "", []


