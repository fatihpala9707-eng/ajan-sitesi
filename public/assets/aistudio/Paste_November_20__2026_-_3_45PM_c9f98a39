async def run(args, client, model_ready, model_note):
    try:
        from playwright.async_api import async_playwright
    except ImportError:
        raise RuntimeError("playwright kurulu değil: pip install -U playwright ; playwright install chromium")

    week = ask_week(args.week)
    CFG.week = week

    budget = Budget()
    async with httpx.AsyncClient(
        timeout=httpx.Timeout(25.0, connect=10.0),
        limits=httpx.Limits(max_connections=MAX_CONCURRENT * 2),
        follow_redirects=False,  # yönlendirmeler download() içinde elle izlenir
        headers={"User-Agent": "DersKaynakAjan/1.0"},
    ) as http_client:
        async with async_playwright() as p:
            browser = await p.chromium.launch(
                headless=not args.visible, slow_mo=200 if args.visible else 0
            )
            try:
                pages, source_urls, link_labels = await crawl(
                    browser, http_client, budget, explore=not args.no_explore
                )
            finally:
                await browser.close()

    dump_pages(pages)
    html_pages = [p for p in pages.values() if p["kind"] == "page"]
    resources = [p for p in pages.values() if p["kind"] == "resource"]
    source_pages = [p for p in pages.values() if p["kind"] == "source"]
    log(f"Tarama bitti: {len(html_pages)} sayfa/etkileşim, {len(resources)} JS/JSON dosyası, "
        f"{len(source_urls)} kaynak bağlantısı, {len(source_pages)} kaynak okundu.")
    if not html_pages:
        raise RuntimeError("Hiç içerik alınamadı. --visible ile deneyin, dump/ ve çıktıyı inceleyin.")

    # 1) Kimlik (ad soyad / okul no): ajan DOLDURMAZ, yalnızca adresi gösterir.
    ident = find_identity_pages(pages, args.identity_pattern)
    forms = find_form_links(pages)
    link = choose_identity_link(ident, forms)
    print("\nAd / okul no bölümü (bunu sen dolduracaksın; ajan dokunmaz):")
    for u, why in ident[:5]:
        print(f"  sayfa [{why}]: {u}")
    for href, label in forms[:5]:
        print(f"  form bağlantısı: {href}  ({label or '-'})")
    if not ident and not forms:
        print("  [uyarı] Otomatik bulunamadı. İstersen --identity-pattern ile desen ver.")
    print(f"  önerilen link: {link}")
    if args.link_ac and not args.dry_run:
        webbrowser.open(link)   # yalnızca --link-ac ile, kullanıcının KENDİ tarayıcısında

    # 2) Görev seçimi: her yol aynı hafta filtresinden geçer
    tasks, uncertain = pick_week_tasks(find_task_pages(pages, args.task_pattern), week, link_labels)
    if not tasks and model_ready and client is not None and not args.dry_run:
        log("[bilgi] Kalıp yöntemi görev bulamadı; yerel model ile sayfa seçimi deneniyor "
            "(yalnızca hafta filtresinden geçen sayfalar gösterilir)...")
        try:
            tasks = await llm_pick_pages(client, pages, week, link_labels)
        except OllamaError as exc:
            log(f"[uyarı] Model ile sayfa seçimi başarısız: {exc}")
    if not tasks:
        tasks = week_fallback_tasks(pages, week, link_labels)
        if tasks:
            log("[uyarı] Görev kalıbı bulunamadı; yalnızca hafta eşleşmesine dayanan DÜŞÜK GÜVENLİ sayfalar seçildi.")
    if uncertain:
        print("\n[BELİRSİZ] Şu sayfalar görev gibi görünüyor ama hafta bilgisi belirsiz; ATANMADI:")
        for u, why in uncertain:
            print(f"  - {u}: {why}")
    if not tasks:
        raise RuntimeError(
            f"{week}. hafta için görev sayfası bulunamadı. dump/_ozet.txt dosyasına bakın "
            f"veya --task-pattern kullanın."
        )
    if not source_pages:
        log("[uyarı] Ayrı kaynak kod bulunamadı; kodlar görev metninde/JS verisinde olabilir.")

    idf = build_idf(pages)
    prepared = []
    for item in tasks:
        source_text, used, skipped = select_sources(pages, item["url"], item["page"], idf, week, link_labels)
        prepared.append((item, source_text, used, skipped))

    if args.dry_run:
        for item, _, used, skipped in prepared:
            print_selection(item, used, skipped)
        print("\n[bilgi] Dry-run bitti: hiçbir yerel modele istek gönderilmedi, tarayıcı linki açılmadı.")
        return

    # 3) Çözüm (yalnızca yerel model) + doğrulama
    os.makedirs("cozumler", exist_ok=True)
    if not model_ready:
        for item, _, used, skipped in prepared:
            print_selection(item, used, skipped)
        report = write_report(week, prepared, uncertain, ident, forms, link, model_note)
        print(f"\n[UYARI] Yerel model kullanılamadığı için ÇÖZÜM ÜRETİLEMEDİ: {model_note}")
        print(f"Tarama ve görev seçimi tamamlandı; rapor: {report}")
        return

    log(f"{week}. hafta: {len(prepared)} görev yerel modele ({CFG.ollama_model}) gönderiliyor...")
    for i, (item, src, used, skipped) in enumerate(prepared, 1):
        print(f"\n{'=' * 78}\nHAFTA {week} - GÖREV {i}: {item['page']['title']}\n{item['url']}\n{'=' * 78}")
        try:
            text, _ = await solve_task(client, item, src, week)
            if not src:
                print("[bilgi] Ayrı kaynak bulunamadı; çözüm görev metnindeki bilgilerle üretildi.")
            text, results = await finalize_code(client, text)
            print(text)
            if not results:
                print("[uyarı] Çözümden Python kod bloğu çıkarılamadı; yalnızca .md kaydedildi.")
            save_solution(week, i, item, text, results, used)
        except OllamaError as exc:
            print(f"[hata] Bu görev çözülemedi (diğer görevlere devam ediliyor): {exc}")
        except Exception as exc:
            print(f"[hata] Beklenmeyen hata, görev atlandı: {type(exc).__name__}: {exc}")

    report = write_report(week, prepared, uncertain, ident, forms, link, model_note)
    print(f"\n{'=' * 78}")
    print(f"Çözümler 'cozumler/' klasörüne kaydedildi (.md + doğrulanmış .py). Rapor: {report}")
    print("Kodlar ÇALIŞTIRILMADI. ast.parse yalnızca SÖZDİZİMİNİ denetler; çalıştığını göstermez.")
    print("Risk taraması eksiksiz bir güvenlik garantisi değildir; kodu çalıştırmadan önce oku.")
    print(f"Ad / okul no bilgilerini kendin gir: {link}")
    print("=" * 78)


async def main(args):
    CFG.start_url = args.start_url
    CFG.debug = args.debug
    CFG.ollama_url = args.ollama_url
    CFG.ollama_model = args.ollama_model
    CFG.num_ctx = args.num_ctx

    if args.ollama_kontrol:
        return await ollama_kontrol()

    if not is_local_url(CFG.ollama_url):
        raise RuntimeError(
            f"Güvenlik: yalnızca yerel Ollama adresi kabul edilir (localhost/127.0.0.1/::1). "
            f"Verilen: {CFG.ollama_url}"
        )

    client, model_ready = None, False
    model_note = "Dry-run: model kullanılmadı."
    if not args.dry_run:
        client = new_ollama_client()
        try:
            await ollama_check(client)
            model_ready = True
            model_note = f"Ollama hazır ({CFG.ollama_model})"
        except OllamaError as exc:
            model_note = str(exc)
            print(f"\n[UYARI] Yerel model kullanılamıyor: {exc}")
            print("  Tarama ve görev seçimi yine çalışacak; ÇÖZÜM ÜRETİLEMEYECEK.")
    try:
        await run(args, client, model_ready, model_note)
    finally:
        if client is not None:
            await client.aclose()
    return 0


def build_parser():
    ap = argparse.ArgumentParser(description="Ders sitesi görev/kaynak ajanı (yerel model, API'siz)")
    ap.add_argument("--start-url", default=CFG.start_url)
    ap.add_argument("--week", type=validate_week, default=None,
                    help=f"Hafta numarası ({WEEK_MIN}-{WEEK_MAX}); verilmezse sorar")
    ap.add_argument("--dry-run", action="store_true",
                    help="Modele hiç istek göndermeden bulunan sayfaları/kaynakları raporla")
    ap.add_argument("--visible", action="store_true", help="Tarayıcıyı görünür aç")
    ap.add_argument("--debug", action="store_true", help="Hatalarda ekran görüntüsü kaydet")
    ap.add_argument("--no-explore", action="store_true", help="Düğme tıklama keşfini kapat")
    ap.add_argument("--task-pattern", default=None, help="Görev sayfası için regex")
    ap.add_argument("--identity-pattern", default=None,
                    help="Ad/okul no sayfasını bulmak için regex (örn. 'teslim|öğrenci no')")
    ap.add_argument("--link-ac", action="store_true",
                    help="Bulunan kimlik sayfasını kendi tarayıcında aç (varsayılan: yalnızca yazdır)")
    ap.add_argument("--ollama-url", default=CFG.ollama_url, help="Yerel Ollama adresi (yalnızca localhost)")
    ap.add_argument("--ollama-model", default=CFG.ollama_model, help="Ollama model adı")
    ap.add_argument("--num-ctx", type=validate_ctx, default=CFG.num_ctx,
                    help=f"Model bağlam uzunluğu (en az {MIN_NUM_CTX})")
    ap.add_argument("--ollama-kontrol", action="store_true", help="Ollama sunucusunu ve modeli kontrol et")
    ap.add_argument("--self-test", action="store_true", help="İnternetsiz kendi kendine testleri çalıştır")
    return ap


if __name__ == "__main__":
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    cli_args = build_parser().parse_args()
    if cli_args.self_test:
        sys.exit(0 if self_test() else 1)
