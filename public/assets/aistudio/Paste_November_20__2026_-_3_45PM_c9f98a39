def build_zip_excerpt(files, week, task_tokens, idf):
    """(metin, seçilenler[(ad, neden)], elenenler[(ad, neden)])
    Seçilen haftanın dosyaları + görevle ilgili haftasız ortak dosyalar alınır;
    başka haftaya ait ve ilgisiz dosyalar elenir."""
    picked, skipped, ranked = [], [], []
    for name, content in files:
        wk = weeks_in(name)
        if wk:
            if week not in wk:
                skipped.append((name, "başka haftaya ait (yol)"))
                continue
            kind, reason = 0, "seçilen haftanın dosyası (yol)"
        else:
            cws = content_week_state(content, week)
            if cws == "other":
                skipped.append((name, "başka haftaya ait (içerik başlığı)"))
                continue
            kind, reason = (0, "seçilen haftanın dosyası (içerik)") if cws == "match" else (1, "")
        sc = overlap_score(task_tokens, tokens(name + " " + content), idf)
        if kind == 1:
            if sc < MIN_COMMON_SCORE:
                skipped.append((name, f"hafta bilgisi yok, görevle ilgisiz (puan {sc:.1f})"))
                continue
            reason = f"ortak dosya, görevle ilgili (puan {sc:.1f})"
        ranked.append((kind, -sc, name, content, reason))
    ranked.sort(key=lambda r: (r[0], r[1], r[2]))

    parts, total, full = [], 0, False
    for kind, _, name, content, reason in ranked:
        if full:
            skipped.append((name, "boyut sınırı"))
            continue
        piece = f"DOSYA: {name}\n{content}"
        if total + len(piece) > MAX_SOURCE_PER_ITEM:
            room = MAX_SOURCE_PER_ITEM - total
            full = True
            if room > 200:
                parts.append(piece[:room])
                picked.append((name, reason + " (kısaltıldı)"))
            else:
                skipped.append((name, "boyut sınırı"))
            continue
        parts.append(piece)
        picked.append((name, reason))
        total += len(piece) + 2
    return "\n\n".join(parts), picked, skipped


def select_sources(pages, task_url, task_page, idf, week, link_labels):
    """(kaynak_metni, kullanılanlar[(adres, karakter, neden)], elenenler[(adres, neden)])"""
    parent = pages.get(task_page.get("parent", ""), {})
    link_source = task_page.get("links") or parent.get("links", [])
    linked = {normalized_url(l["href"]): l.get("label", "") for l in link_source if l.get("href")}
    task_tokens = tokens(task_page["text"])
    origin = task_page.get("origin")

    candidates, skipped = [], []
    for url, page in pages.items():
        if url == task_url or url == task_page.get("parent") or page["kind"] == "resource":
            continue
        labels = link_labels.get(url, ())
        state = week_state(url, labels, week)
        is_linked = url in linked

        if page["kind"] == "source":
            if state == "other":
                skipped.append((url, "başka haftaya ait (URL/etiket)"))
                continue
            if page.get("files"):
                content, picked, fskipped = build_zip_excerpt(page["files"], week, task_tokens, idf)
                skipped.extend((f"{url} :: {n}", r) for n, r in fskipped)
                if not content:
                    skipped.append((url, "zip/repo: uygun dosya bulunamadı"))
                    continue
                names = ", ".join(n for n, _ in picked[:4])
                priority = 0 if any(r.startswith("seçilen haftanın") for _, r in picked) else 1
                reason = f"zip/repo: {len(picked)} dosya seçildi ({names}{'...' if len(picked) > 4 else ''})"
                score = overlap_score(task_tokens, tokens(content), idf)
            else:
                content = page["text"]
                if content_week_state(content, week) == "other":
                    skipped.append((url, "başka haftaya ait (içerik başlığı)"))
                    continue
                score = overlap_score(task_tokens, tokens(content), idf)
                if state == "match" or content_week_state(content, week) == "match":
                    priority, reason = 0, "seçilen haftaya ait"
                elif origin and page.get("origin") == origin:
                    priority, reason = 0, "görevle aynı JS verisinden"
                elif is_linked and score >= MIN_SCORE_LINKED:
                    priority, reason = 1, f"göreve bağlantılı ve ilgili (puan {score:.1f})"
                elif score >= MIN_SCORE_UNLINKED:
                    priority, reason = 2, f"hafta bilgisi yok; görevle güçlü ilişki (puan {score:.1f})"
                else:
                    skipped.append((url, f"hafta bilgisi yok ve görevle ilgisiz (puan {score:.1f})"))
                    continue
        else:
            if not (is_linked or state == "match"):
                continue
            has_code = "KOD BLOKLARI:" in page["text"]
            label_ok = SOURCE_LABEL_WORDS.search(normalize_text(linked.get(url, "")))
            if not (has_code or label_ok):
                continue
            if state == "other":
                skipped.append((url, "başka haftaya ait (URL/etiket)"))
                continue
            scoped, how, status = scope_for_week(page["title"], url, page["text"], labels, week)
            if status in ("other", "conflict"):
                skipped.append((url, f"hafta uyuşmuyor/belirsiz ({how})"))
                continue
            content = scoped if status == "match" else page["text"]
            score = overlap_score(task_tokens, tokens(content), idf)
            if score < MIN_SCORE_LINKED:
                skipped.append((url, f"görevle ilgisiz (puan {score:.1f})"))
                continue
            priority = 1 if status == "match" else 2
            reason = f"kod içeren bağlantılı sayfa (puan {score:.1f}; {how})"
        candidates.append((priority, -score, url, content, reason))

    candidates.sort(key=lambda c: (c[0], c[1], c[2]))
    blocks, used, remaining = [], [], MAX_SOURCE_CHARS
    for _, _, url, content, reason in candidates:
        header = f"Kaynak adresi: {url}\n"
        available = min(remaining - len(header), MAX_SOURCE_PER_ITEM)
        if available <= 100:
            skipped.append((url, "toplam kaynak boyut sınırı"))
            continue
        excerpt = content[:available]
        blocks.append(header + excerpt)
        used.append((url, len(excerpt), reason))
        remaining -= len(header) + len(excerpt) + 2
    return "\n\n".join(blocks), used, skipped


