async def settle(page):
    try:
        await page.wait_for_load_state("networkidle", timeout=4_000)
    except Exception:
        pass
    await page.wait_for_timeout(1000)


async def extract_page_content(page):
    """(başlık, metin, bağlantılar, kimlik_alan_ipuçları, giriş_alanı_sayısı)"""
    data = await page.evaluate(PAGE_JS)
    text = (data["text"] or "").strip()
    fields = await page.evaluate(FIELDS_JS)
    id_fields = list(fields.get("idFields", []))
    input_count = int(fields.get("inputCount", 0))
    for frame in page.frames:
        if frame == page.main_frame:
            continue
        try:
            ft = await frame.evaluate("document.body ? document.body.innerText : ''")
            if ft and ft.strip():
                text += "\n\nGÖMÜLÜ ÇERÇEVE:\n" + ft.strip()
            ff = await frame.evaluate(FIELDS_JS)
            id_fields += list(ff.get("idFields", []))
            input_count += int(ff.get("inputCount", 0))
        except Exception:
            pass
    if data["code"]:
        text += "\n\nKOD BLOKLARI:\n" + "\n\n".join(data["code"])
    return data["title"], text.strip(), data["links"], id_fields, input_count


async def read_html_page(context, url, retries=1):
    for attempt in range(retries + 1):
        page = await context.new_page()
        try:
            response = await page.goto(url, wait_until="domcontentloaded", timeout=40_000)
            if response and response.status >= 400:
                log(f"[uyarı] HTTP {response.status}: {url}")
                await save_debug_screenshot(page, url, f"http{response.status}")
                return None
            ctype = (response.headers.get("content-type", "") if response else "").lower()
            if ctype and "html" not in ctype and "xml" not in ctype:
                log(f"[bilgi] HTML olmayan içerik atlandı ({ctype}): {url}")
                return None

            await settle(page)
            title, text, links, id_fields, input_count = await extract_page_content(page)
            if not text:
                log(f"[uyarı] Boş içerik: {url}")
                await save_debug_screenshot(page, url, "bos")
                return None
            has_identity = any(IDENTITY_PATTERN.search(normalize_text(f)) for f in id_fields)
            if not has_identity and len(text) < 400 and LOGIN_HINTS.search(normalize_text(text)):
                log(f"[uyarı] Giriş/captcha sayfası olabilir, atlandı: {url}")
                await save_debug_screenshot(page, url, "giris")
                return None
            return {"url": url, "title": title, "text": text, "links": links, "kind": "page",
                    "has_identity": has_identity, "input_count": input_count}
        except Exception as exc:
            if "Download is starting" in str(exc):
                log(f"[bilgi] İndirme başlatan adres atlandı: {url}")
                return None
            log(f"[uyarı] Sayfa okunamadı (deneme {attempt + 1}): {url} ({exc})")
            await save_debug_screenshot(page, url, "hata")
        finally:
            await page.close()
    return None


async def explore_interactions(browser, base, semaphore, deadline):
    """Her sayfa için AYRI, çerezsiz bağlam: tıklamaların istemci durumu diğer işlere sızmaz."""
    url = base["url"]
    results = []
    async with semaphore:
        context = await new_safe_context(browser)
        page = await context.new_page()
        try:
            await page.goto(url, wait_until="domcontentloaded", timeout=40_000)
            await settle(page)
            labels = await page.evaluate(ANNOTATE_JS, INTERACT_PATTERN)

            seen_labels, targets = set(), []
            for idx, label in enumerate(labels):
                if label not in seen_labels:
                    seen_labels.add(label)
                    targets.append((idx, label))
            targets = targets[:MAX_INTERACTIONS]
            log(f"[keşif] {url}: {len(targets)} tıklanabilir öğe bulundu")

            seen_fp = {fingerprint(base["text"])}
            for n, (idx, label) in enumerate(targets):
                if time.monotonic() > deadline:
                    log("[keşif] süre doldu, eldekiyle devam")
                    break
                if n > 0:
                    await page.goto(url, wait_until="domcontentloaded", timeout=40_000)
                    await settle(page)
                    await page.evaluate(ANNOTATE_JS, INTERACT_PATTERN)
                try:
                    await page.click(f'[data-ajan-i="{idx}"]', timeout=3_000)
                    await page.wait_for_timeout(800)
                    for extra in list(context.pages):      # açılan pencereleri kapat
                        if extra is not page:
                            try:
                                await extra.close()
                            except Exception:
                                pass
                    title, text, _, _, _ = await extract_page_content(page)
                except Exception:
                    continue
                fp = fingerprint(text)
                if len(text) < 150 or fp in seen_fp:
                    continue
                seen_fp.add(fp)
                log(f"[keşif] {n + 1}/{len(targets)} '{label}' -> {len(text)} karakter yeni içerik")
                results.append({
                    "url": f"{url}#etkilesim-{n + 1}-{re.sub(r'[^a-zA-Z0-9]+', '_', label)[:30]}",
                    "title": f"{label} | {title}", "text": text,
                    "links": [], "kind": "page", "parent": url,
                })
        except Exception as exc:
            log(f"[uyarı] Etkileşim keşfi başarısız: {url} ({exc})")
            await save_debug_screenshot(page, url, "kesif")
        finally:
            try:
                await page.close()
                await context.close()
            except Exception:
                pass
    return results


