def validate_week(value):
    """argparse tipi: yalnızca 1-20 arası tam sayı."""
    try:
        n = int(str(value).strip())
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"'{value}' geçerli bir hafta değil; {WEEK_MIN}-{WEEK_MAX} arası bir tam sayı girin."
        )
    if not (WEEK_MIN <= n <= WEEK_MAX):
        raise argparse.ArgumentTypeError(
            f"Hafta {n} geçersiz; {WEEK_MIN}-{WEEK_MAX} arası bir tam sayı girin."
        )
    return n


def validate_ctx(value):
    try:
        n = int(str(value).strip())
    except ValueError:
        raise argparse.ArgumentTypeError(f"'{value}' geçerli bir sayı değil.")
    if n < MIN_NUM_CTX:
        raise argparse.ArgumentTypeError(f"--num-ctx en az {MIN_NUM_CTX} olmalı.")
    return n


def ask_week(cli_week):
    if cli_week is not None:
        return cli_week
    while True:
        try:
            raw = input(f"\nKaçıncı hafta? ({WEEK_MIN}-{WEEK_MAX}): ")
        except EOFError:
            raise RuntimeError("Hafta numarası alınamadı; --week ile verin.")
        try:
            return validate_week(raw)
        except argparse.ArgumentTypeError as exc:
            print(exc)


WEEK_PATTERNS = (
    re.compile(r"hafta[\s_\-:]*0*(\d{1,2})(?!\d)"),
    re.compile(r"(?<!\d)0*(\d{1,2})[\s.\-_]*hafta(?!l[ıi]k)"),
    re.compile(r"week[\s_\-]*0*(\d{1,2})(?!\d)"),
)


def week_marks(text):
    """[(konum, hafta_no)] listesi; yalnızca WEEK_MIN..WEEK_MAX arası numaralar."""
    t = normalize_text(text)
    marks = []
    for rx in WEEK_PATTERNS:
        for m in rx.finditer(t):
            num = int(m.group(1))
            if WEEK_MIN <= num <= WEEK_MAX:
                marks.append((m.start(), num))
    marks.sort()
    return marks


def weeks_in(text):
    return {num for _, num in week_marks(text)}


def heading_marks(text):
    """Başlık gibi duran satırlardaki hafta işaretleri: [(orijinal_metindeki_konum, hafta_no)].
    Yalnızca kısa (<= 80 karakter) ve tek hafta içeren satırlar bölüm başlığı sayılır."""
    out, pos = [], 0
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped and len(stripped) <= 80:
            nums = weeks_in(stripped)
            if len(nums) == 1:
                out.append((pos, next(iter(nums))))
        pos += len(line) + 1
    return out


def scope_for_week(title, url, text, labels, n):
    """(ilgili_metin, açıklama, durum). durum: match | other | unknown | conflict
    match    : sayfa/bölüm n. haftaya ait (ilgili metin döner)
    other    : başka haftaya ait
    unknown  : hiç hafta bilgisi yok (ATANMAZ, raporlanır)
    conflict : bilgiler çelişiyor veya bölüm çıkarılamadı (ATANMAZ, raporlanır)"""
    head = weeks_in(f"{title} {url} {' '.join(labels)}")
    body = weeks_in(text)

    if not body:
        if head:
            if n in head:
                return text, "başlık/URL/etiket (metinde hafta bilgisi yok)", "match"
            return "", "başka hafta (başlık/URL/etiket)", "other"
        return "", "hafta bilgisi yok", "unknown"

    if body == {n}:
        if head and n not in head:
            return "", "başlık/URL ile metindeki hafta çelişiyor", "conflict"
        return text, "metin", "match"

    if n not in body:
        if n in head:
            return "", "başlık/URL ile metindeki hafta çelişiyor", "conflict"
        return "", "başka hafta (metin)", "other"

    # Metinde birden fazla hafta var ve n de içinde: yalnızca n'in bölümünü çıkar.
    marks = heading_marks(text)
    segs = []
    for i, (pos, num) in enumerate(marks):
        if num != n:
            continue
        end = len(text)
        for pos2, num2 in marks[i + 1:]:
            if num2 != n:
                end = pos2
                break
        segs.append(text[pos:end].strip())
    uniq = []
    for s in segs:
        if s and not any(s in u for u in uniq):
            uniq.append(s)
    out = "\n\n".join(uniq)
    if len(out) < MIN_SECTION_CHARS:
        return "", "hafta bölümü bulunamadı veya çok kısa (belirsiz)", "conflict"
    return out, "çok haftalı sayfadan ilgili bölüm", "match"


def week_state(url, labels, n):
    """Kaynağın URL/bağlantı etiketleri hangi haftayı söylüyor? match | other | neutral"""
    w = weeks_in(f"{url} {' '.join(labels)}")
    if not w:
        return "neutral"
    return "match" if n in w else "other"


def content_week_state(content, n):
    """Dosya içeriğinin ilk satırlarındaki hafta bilgisi: match | other | neutral"""
    w = weeks_in(content[:400])
    if not w:
        return "neutral"
    return "match" if n in w else "other"


