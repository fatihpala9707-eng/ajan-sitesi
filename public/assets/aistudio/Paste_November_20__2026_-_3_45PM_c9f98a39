)


def neutralize(text):
    """Veri içindeki kapanış etiketlerini bozar: veri, şablon etiketlerinden 'çıkamaz'."""
    return text.replace("</", "<\u200b/")


def max_prompt_chars():
    return int((CFG.num_ctx - MAX_ANSWER_TOKENS) * CHARS_PER_TOKEN)


def build_user_prompt(task_url, task_text, source_text, week, max_chars):
    sources = source_text or "(Bu görev için ayrı kaynak kod bulunamadı.)"
    head = f"GÖREV SAYFASI: {task_url}\nSEÇİLEN HAFTA: {week}\n\n"
    budget = max(max_chars - len(head) - len(SYSTEM_PROMPT) - 200, 2000)
    task_budget = min(len(task_text), MAX_TASK_CHARS, int(budget * 0.6))
    src_budget = max(budget - task_budget, 0)
    return (
        f"{head}<gorev_icerigi>\n{neutralize(task_text[:task_budget])}\n</gorev_icerigi>\n\n"
        f"<kaynaklar>\n{neutralize(sources[:src_budget])}\n</kaynaklar>"
    )


async def solve_task(client, item, source_text, week):
    user = build_user_prompt(item["url"], item["page"]["text"], source_text, week, max_prompt_chars())
    text, truncated = await ollama_chat(client, SYSTEM_PROMPT, user)
    if truncated:
        text += "\n\n[uyarı: yanıt çıktı sınırında kesildi; çözüm eksik olabilir]"
    return text, truncated


async def finalize_code(client, answer):
    """(güncel_cevap, [(kod, hata_veya_None)]). Blok yoksa bir kez biçimlendirtir; hatalıysa en
    fazla MAX_REPAIRS kez onarttırır. Kod ÇALIŞTIRILMAZ."""
    half = max(max_prompt_chars() // 2, 2000)
    blocks = extract_code_blocks(answer)
    if not blocks:
        try:
            regen, _ = await ollama_chat(client, CODE_ONLY_SYSTEM, f"<cevap>\n{neutralize(answer[:half])}\n</cevap>")
        except OllamaError as exc:
            log(f"[uyarı] Kod bloğu otomatik üretilemedi: {exc}")
            regen = ""
        blocks = extract_code_blocks(regen)
        if blocks:
            answer += "\n\n[ek: kod bloğu otomatik üretildi]\n\n" + regen

    results, repair_ok = [], True
    for b in blocks:
        code = b["code"]
        err = check_python(code) if b["closed"] else "kod bloğu yarıda kesilmiş"
        tries = 0
        while err and tries < MAX_REPAIRS and repair_ok:
            try:
                fixed, _ = await ollama_chat(
                    client, REPAIR_SYSTEM,
                    f"Kodda sorun var: {err}\n\n```python\n{code[:half]}\n```",
                )
            except OllamaError as exc:
                log(f"[uyarı] Kod onarımı yapılamadı: {exc}")
                repair_ok = False
                break
            fb = extract_code_blocks(fixed)
            if not fb:
                break
            code = fb[0]["code"]
            err = check_python(code) if fb[0]["closed"] else "kod bloğu yarıda kesilmiş"
            tries += 1
        results.append((code, err))
    return answer, results


