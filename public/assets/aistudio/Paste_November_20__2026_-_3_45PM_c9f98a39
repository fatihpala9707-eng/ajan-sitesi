# ----------------------------------------------------------------------------
FENCE_RE = re.compile(r"```([\w+#.\-]*)[ \t]*\n(.*?)(?:```|\Z)", re.S)
PY_LANGS = {"python", "py", "python3", "py3"}
PY_HINT = re.compile(r"^\s*(def|class|import|from)\s+\w+", re.M)
NON_PY_HINT = re.compile(
    r"using\s+System|namespace\s+\w+|Console\.|public\s+static\s+void|#include|\bvar\s+\w+\s*=.*;"
)

RISKY_IMPORTS = {"subprocess", "socket", "requests", "urllib", "shutil", "ctypes", "http",
                 "ftplib", "smtplib", "webbrowser", "httpx", "aiohttp"}
RISKY_CALLS = {"eval", "exec", "__import__", "compile"}
RISKY_ATTRS = {("os", "system"), ("os", "remove"), ("os", "rmdir"), ("os", "unlink"),
               ("os", "popen"), ("os", "removedirs"), ("os", "rename"),
               ("shutil", "rmtree"), ("shutil", "move")}
RISKY_ANY_ATTR = {"unlink", "rmdir", "rmtree", "write_text", "write_bytes", "popen"}


def check_python(code):
    """Sözdizimi hatası varsa açıklama, yoksa None. (Kod ÇALIŞTIRILMAZ.)"""
    try:
        ast.parse(code)
        return None
    except SyntaxError as exc:
        return f"{exc.msg} (satır {exc.lineno})"
    except ValueError as exc:
        return str(exc)


def is_probably_python(code):
    if NON_PY_HINT.search(code):
        return False
    if PY_HINT.search(code):
        return True
    return check_python(code) is None and ("(" in code or "=" in code)


def extract_code_blocks(answer):
    """Python olabilecek bloklar: [{'code', 'closed'}]. csharp/json/bash vb. etiketliler atlanır;
    etiketsiz bloklar yalnızca Python'a benziyorsa alınır."""
    blocks = []
    for m in FENCE_RE.finditer(answer):
        lang = m.group(1).lower()
        code = m.group(2)
        closed = m.group(0).endswith("```")
        if lang in PY_LANGS:
            pass
        elif lang == "":
            if not is_probably_python(code):
                continue
        else:
            continue
        if code.strip():
            blocks.append({"code": code, "closed": closed})
    return blocks


def risky_findings(code):
    out = set()
    try:
        tree = ast.parse(code)
    except (SyntaxError, ValueError):
        return []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for a in node.names:
                if a.name.split(".")[0] in RISKY_IMPORTS:
                    out.add(f"import {a.name}")
        elif isinstance(node, ast.ImportFrom):
            if (node.module or "").split(".")[0] in RISKY_IMPORTS:
                out.add(f"from {node.module} import ...")
        elif isinstance(node, ast.Call):
            f = node.func
            if isinstance(f, ast.Name):
                if f.id in RISKY_CALLS:
                    out.add(f"{f.id}()")
                elif f.id == "open":
                    mode = None
                    if len(node.args) >= 2 and isinstance(node.args[1], ast.Constant) \
                            and isinstance(node.args[1].value, str):
                        mode = node.args[1].value
                    for kw in node.keywords:
                        if kw.arg == "mode" and isinstance(kw.value, ast.Constant) \
                                and isinstance(kw.value.value, str):
                            mode = kw.value.value
                    if mode and any(c in mode for c in "wax+"):
                        out.add("open(... yazma modu)")
            elif isinstance(f, ast.Attribute):
                if f.attr in RISKY_ANY_ATTR:
                    out.add(f".{f.attr}()")
                if isinstance(f.value, ast.Name) and (f.value.id, f.attr) in RISKY_ATTRS:
                    out.add(f"{f.value.id}.{f.attr}()")
    return sorted(out)


