        sys.exit(asyncio.run(main(cli_args)) or 0)
    except KeyboardInterrupt:
        print("\n[bilgi] Ajan kullanıcı tarafından durduruldu.")
    except Exception as exc:
        print(f"\n[KRİTİK HATA] {type(exc).__name__}: {exc}")
        traceback.print_exc()
        sys.exit(1)