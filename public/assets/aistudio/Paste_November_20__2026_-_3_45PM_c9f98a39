class OllamaError(Exception):
    pass


def is_local_url(url):
    try:
        parts = urlsplit(url)
    except ValueError:
        return False
    return parts.scheme in ("http", "https") and (parts.hostname or "").lower() in LOCAL_HOSTS


def ollama_base():
    return CFG.ollama_url.rstrip("/")


def new_ollama_client():
    # trust_env=False: ortam proxy'leri kullanılmaz, istek doğrudan yerel sunucuya gider.
    return httpx.AsyncClient(timeout=httpx.Timeout(OLLAMA_TIMEOUT, connect=5.0), trust_env=False)


async def ollama_check(client):
    """Sunucu ve model hazır mı? Değilse OllamaError (anlaşılır Türkçe mesaj)."""
    base = ollama_base()
    try:
        r = await client.get(f"{base}/api/tags", timeout=10.0)
    except httpx.ConnectError:
        raise OllamaError(
            f"Ollama sunucusuna bağlanılamadı ({base}). Kurulu değilse: winget install Ollama.Ollama "
            f"(veya https://ollama.com/download). Kuruluysa başlat: ollama serve"
        )
    except httpx.TimeoutException:
        raise OllamaError(f"Ollama sunucusu zamanında yanıt vermedi ({base}).")
    except httpx.HTTPError as exc:
        raise OllamaError(f"Ollama bağlantı hatası: {exc}")
    if r.status_code != 200:
        raise OllamaError(f"Ollama beklenmeyen yanıt verdi (HTTP {r.status_code}). Adres doğru mu: {base}")
    try:
        data = r.json()
    except ValueError:
        raise OllamaError(f"Bu adres Ollama gibi yanıt vermiyor: {base}")
    models = data.get("models", []) if isinstance(data, dict) else []
    names = [(m.get("name") or m.get("model") or "") for m in models if isinstance(m, dict)]
    want = CFG.ollama_model
    if want in names or (":" not in want and f"{want}:latest" in names):
        return names
    if names:
        raise OllamaError(
            f"'{want}' modeli yüklü değil. Yüklü modeller: {', '.join(names)}. "
            f"İndirmek için: ollama pull {want}   (veya --ollama-model ile yüklü birini seç)"
        )
    raise OllamaError(f"Ollama'da hiç model yüklü değil. İndirmek için: ollama pull {want}")


async def ollama_chat(client, system, user, max_tokens=MAX_ANSWER_TOKENS):
    """(metin, kesildi_mi). Hata olursa OllamaError."""
    payload = {
        "model": CFG.ollama_model,
        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
        "stream": False,
        "options": {"num_ctx": CFG.num_ctx, "num_predict": max_tokens, "temperature": 0.2},
    }
    try:
        r = await client.post(f"{ollama_base()}/api/chat", json=payload)
    except httpx.ConnectError:
        raise OllamaError("Ollama bağlantısı koptu veya sunucu kapandı (ollama serve çalışıyor mu?).")
    except httpx.TimeoutException:
        raise OllamaError(
            f"Model {OLLAMA_TIMEOUT} sn içinde yanıt vermedi (model büyük olabilir; "
            f"daha küçük bir model veya daha küçük --num-ctx dene)."
        )
    except httpx.HTTPError as exc:
        raise OllamaError(f"Ollama isteği başarısız: {exc}")
    if r.status_code != 200:
        try:
            detail = str(r.json().get("error", ""))
        except (ValueError, AttributeError):
            detail = r.text[:200]
        if r.status_code == 404 or "not found" in detail.lower():
            raise OllamaError(f"'{CFG.ollama_model}' modeli bulunamadı. Çalıştır: ollama pull {CFG.ollama_model}")
        raise OllamaError(f"Ollama hata verdi (HTTP {r.status_code}): {detail}")
    try:
        data = r.json()
    except ValueError:
        raise OllamaError("Ollama geçersiz (JSON olmayan) yanıt verdi.")
    msg = data.get("message") if isinstance(data, dict) else None
    text = (msg or {}).get("content") or ""
    if not text.strip():
        raise OllamaError("Model boş yanıt döndürdü (daha büyük/farklı bir model veya --num-ctx dene).")
    return text, data.get("done_reason") == "length"


